{
  "system": "Inspiration Properties UK Lead & Finance Engine",
  "mode": "controlled_autonomy",
  "contacting_enabled": false,
  "referral_enabled": false,
  "publishing_enabled": false,
  "agents": [
    "lead_finder",
    "verification",
    "deduplication",
    "lead_scorer",
    "finance_classifier",
