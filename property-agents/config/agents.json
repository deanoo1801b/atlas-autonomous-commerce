    "orchestrator",
    "planning_opportunity_detector",
    "buyer_intelligence",
    "buyer_prospecting",
    "contract_route_comparator"
  ],
  "hard_stops": [
    "unverified_identity",
    "missing_evidence",
    "unclear_regulatory_status",
    "personalised_regulated_finance_advice",
    "unauthorised_financial_promotion",
    "contact_permission_missing",
    "duplicate_lead",
    "material_data_conflict"
  ],
  "designated_area": {
    "region": "London, London outskirts, South East England",
    "locations": [
      "London",
