    "priority_bmv_discount_pct": 25,
    "top_priority_bmv_discount_pct": 30,
    "minimum_comparable_sales": 3,
    "comparable_lookback_months": 12,
    "owner_direct_priority": true,
    "agent_listings_allowed_for_market_intelligence_only": true
  },
  "bmv_rules": {
    "discount_formula": "(estimated_market_value-asking_price)/estimated_market_value*100",
    "discount_basis": "recent sold comparables for similar property type, size, condition and micro-location; asking prices alone are insufficient",
    "tier_a_min_pct": 30,
    "tier_b_min_pct": 25,
    "below_threshold": "exclude from BMV shortlist unless human reviewer overrides with documented flip case",
    "unknown_valuation": "REVIEW - never label BMV without comparable evidence",
    "flip_profit_must_be_costed": true
  },
  "planning_opportunities": {
    "enabled": true,
    "source": "Planning Data API for England",
    "max_properties_per_run": 25,
    "look_for": [
      "same-road planning precedents",
      "loft conversions and dormers",
      "rear/side/two-storey extensions",
      "additional bedrooms",
      "conversions and subdivisions",
      "annexes and additional dwellings"
    ],
    "decision_rule": "same-road approved applications are a precedent signal only, never proof of permission for target property",
    "missing_data": "check local council planning portal; never interpret no API result as no planning history",
    "profit_model": "completed value minus purchase price, works, contingency, professional fees, finance/holding, purchase costs and selling costs; before tax unless separately modelled",
    "minimum_cost_inputs": [
      "asking_price",
      "estimated_completed_value",
      "works_cost",
      "professional_fees",
      "finance_and_holding",
      "purchase_costs",
      "selling_costs"
    ]
  },
  "buyer_intelligence": {
    "enabled": true,
    "mode": "offline_matching_only",
    "buyer_discovery": false,
    "contacting_enabled": false,
    "referral_enabled": false,
    "publishing_enabled": false,
    "verification_max_age_days": 90,
    "required_checks": [
      "identity_verified",
      "funding_evidence_status",
      "verification_date",
      "consent_status"
    ],
    "matching_criteria": [
      "budget",
      "location",
      "investment_strategy",
      "minimum_profit_before_tax",
      "valuation_evidence"
    ],
    "guardrail": "Scores are triage only; human review required. Never label buyer verified without evidence."
  },
  "buyer_prospecting": {
    "enabled": true,
    "mode": "public_source_register_only",
    "seed_register": "property-agents/data/buyer_prospects_seed.json",
    "automatic_contacting": false,
    "referral_enabled": false,
    "publishing_enabled": false,
    "public_profiles_are_verified_buyers": false,
    "guardrail": "Record source evidence and published criteria only. Verify identity, current mandate, purchasing capacity and consent separately before treating any person or business as a verified buyer."
  },
  "contract_route_comparator": {
    "enabled": true,
    "mode": "offline_analysis_only",
    "compare_routes": [
      "contract_assignment",
      "property_sourcing"
    ],
    "automatic_contacting": false,
    "automatic_offers": false,
    "automatic_contracting": false,
    "automatic_payments": false,
    "referral_enabled": false,
    "publishing_enabled": false,
    "hard_stop_on_unresolved_legal_risk": true,
    "minimum_comparable_sales": 3,
    "guardrail": "Scenario comparison only, not legal advice or a recommendation to transact. Require independent solicitor review and human approval. Never infer assignment rights, seller consent, regulatory compliance, or buyer funding."
  }
}
